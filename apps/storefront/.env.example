# Storefront Environment Variables Example

# CMS Home Page fallback
CMS_HOME_KEY=home

# Tracking (Fallback if not configured via Admin CMS Site Settings > Tracking)
# GTM Web Container ID (Format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# GTM Server Container / Stape Tagging URL (HTTPS only, hostname with optional port, no path)
# Example: https://ss.dsmart.digislashagency.com
NEXT_PUBLIC_GTM_SERVER_URL=

# Default Consent Mode v2 status ('granted' or 'denied')
NEXT_PUBLIC_CONSENT_DEFAULT=denied
