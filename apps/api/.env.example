# Local development; supply real credentials through your deployment secrets.
DATABASE_URL=postgresql://commerce:replace-me@localhost:5434/commerce_db?schema=public
PORT=4000
ADMIN_ORIGINS=http://localhost:3001
NODE_ENV=development
STOREFRONT_CHECKOUT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Use the same secret in the storefront server's runtime environment for analytics.

# Local development defaults to ./uploads. In production choose S3 or set
# MEDIA_ROOT explicitly to a durable shared volume. Existing local assets
# need to remain served or be migrated when switching providers.
MEDIA_STORAGE=local
# MEDIA_ROOT=/var/lib/commerce/media

# S3 uses the standard AWS credential provider chain (prefer workload roles).
# MEDIA_STORAGE=s3
# AWS_REGION=ap-south-1
# MEDIA_S3_BUCKET=your-catalog-bucket
# MEDIA_PUBLIC_URL=https://media.your-store.example
# MEDIA_S3_PREFIX=catalog/

# Separate database ONLY; never point regression tests at commerce_db.
# CATALOG_TEST_DATABASE_URL=postgresql://commerce:replace-me@localhost:5434/commerce_catalog_validation_local?schema=public

# Return requests must be opened within this many days of confirmed delivery.
ORDER_RETURN_WINDOW_DAYS=14
# Optional; test:orders defaults to a separate commerce_orders_validation_20261018
# database on the configured local PostgreSQL server. Tests never reset a database.
# ORDERS_TEST_DATABASE_URL=postgresql://commerce:replace-me@localhost:5434/commerce_orders_validation_local?schema=public

# --- Bangladesh Payment Gateway Integrations ---
# bKash Tokenized Checkout
# In development or when credentials are not supplied, the adapter runs in safe simulation mode.
# BKASH_APP_KEY=your_bkash_app_key
# BKASH_APP_SECRET=your_bkash_app_secret
# BKASH_USERNAME=your_bkash_username
# BKASH_PASSWORD=your_bkash_password
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# BKASH_SIMULATE=false

# SSLCommerz Hosted Checkout (EasyCheckout)
# SSLCOMMERZ_STORE_ID=your_store_id
# SSLCOMMERZ_STORE_PASSWORD=your_store_password
# SSLCOMMERZ_IS_SANDBOX=true
# SSLCOMMERZ_SIMULATE=false

