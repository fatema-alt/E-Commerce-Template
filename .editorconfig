# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Avoid re-encoding on Windows: ensure editors and shells save in UTF-8 without BOM; do not write files using default Windows ANSI/CP1252.

[*.md]
trim_trailing_whitespace = false
